// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Account
model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String   // Hashed password
  role        String   @default("user") // admin, user
  status      String   @default("active") // active, disabled
  maxStorageQuota BigInt @default(214748364800) // Default 200GB in bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  projects        Project[]
  datasets      Dataset[]
  models        Model[]
  trainingConfigs TrainingConfig[]
  trainingJobs  TrainingJob[]
  validationJobs ValidationJob[]
  activityLogs  ActivityLog[]
  deployedModels DeployedModel[]
}
model SystemConfig {
  id                    String   @id @default(cuid())
  condaEnv              String?  // Conda environment name (e.g., "paddle", "paddle_env")
  condaPath             String?  // Path to conda executable (e.g., "C:\\Users\\name\\anaconda3\\Scripts\\conda.exe")
  pythonEnvsBasePath    String?  // Base path where multiple Python environments are stored
  gpuPythonMappings     String?  // JSON string mapping GPU IDs to Python environment paths (e.g., {"0": "C:/envs/gpu0/python.exe", "1": "C:/envs/gpu1/python.exe"})
  // JSON string mapping a framework (optionally "<framework>:<gpuId>") to a
  // Python interpreter, e.g. {"TorchSeg": "D:/pythonEnvs/torchEnv/Scripts/python.exe"}.
  // Needed because a Paddle env has no `torch` and vice versa, so the per-GPU
  // map above cannot serve both runtimes. Falls back to gpuPythonMappings.
  frameworkPythonMappings String?
  userConfigsPath       String?  // Base path for user-specific training configs (replaces PaddleDetection\configs\autotrain)
  userDatabasePath      String?  // Base path for user database storage
  paddleDetectionPath   String?
  paddleClasPath        String?
  paddleSegPath         String?
  // Repository root of the bundled PyTorch trainer (`torchtrain/`). Shared by
  // the TorchDet and TorchSeg frameworks, which differ only in config schema.
  torchPath             String?
  defaultFramework      String   @default("PaddleDetection")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Project
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  framework   String   @default("PaddleDetection") // PaddleDetection, PaddleClas or PaddleSeg
  task        String   @default("detection") // detection / instance_segmentation (PaddleDetection), semantic_segmentation (PaddleSeg)
  status      String   @default("active") // active, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  datasets        Dataset[]
  models          Model[]
  trainingConfigs TrainingConfig[]
  trainingJobs    TrainingJob[]
  validationJobs  ValidationJob[]
  deployedModels  DeployedModel[]
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Dataset
model Dataset {
  id          String   @id @default(cuid())
  name        String
  description String?
  projectId   String
  format      String   @default("COCO") // COCO, VOC, etc.
  
  // Paths
  trainImagePath  String?
  trainAnnoPath   String?
  evalImagePath   String?
  evalAnnoPath    String?
  datasetDir      String?

  // Unsupervised anomaly datasets (format = "AnomalyFolder"). Directory names
  // relative to `datasetDir`, mapped onto anomalib's Folder datamodule.
  // Only `normalDir` is required: it is the *only* directory that is trained on.
  // `abnormalDir` (+ optional `maskDir`) feed the validation/test split, which is
  // also where the anomaly-score threshold is chosen — see docs/ANOMALY_DETECTION_DESIGN.md.
  normalDir       String?
  normalTestDir   String?
  abnormalDir     String?
  maskDir         String?
  
  // Statistics
  numClasses      Int      @default(0)
  numAnnotations  Int      @default(0)
  numTrainImages  Int      @default(0)
  numEvalImages   Int      @default(0)
  classStats      String?  // JSON string for class statistics
  
  // Full YAML config (for dataset configuration)
  yamlConfig    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trainingJobs  TrainingJob[]
}

// Model Configuration
model Model {
  id          String   @id @default(cuid())
  name        String
  description String?
  projectId   String
  
  // Model Architecture
  architecture  String  @default("YOLOv3")
  backbone      String  @default("CSPResNet")
  neck          String  @default("CustomCSPPAN")
  head          String  @default("PPYOLOEHead")
  
  // Model Parameters
  numClasses    Int     @default(1)
  normType      String  @default("sync_bn")
  useEma        Boolean @default(true)
  emaDecay      Float   @default(0.9998)
  depthMult     Float   @default(0.33)
  widthMult     Float   @default(0.50)
  
  // Pretrained weights
  pretrainWeights String?
  
  yamlConfig    String?
  
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trainingJobs  TrainingJob[]
}

// Training Configuration
model TrainingConfig {
  id          String   @id @default(cuid())
  name        String
  projectId   String

  // Training parameters
  epoch       Int      @default(100)
  batchSize   Int      @default(8)
  baseLr      Float    @default(0.001)
  momentum    Float    @default(0.9)
  weightDecay Float    @default(0.0005)

  // Scheduler
  scheduler   String   @default("CosineDecay")
  warmupEpochs Int     @default(5)
  maxEpochs   Int      @default(100)

  // PaddleSeg uses iterations instead of epochs (nullable; ignored by other frameworks)
  iters        Int?
  saveInterval Int?

  // Reader settings
  workerNum   Int      @default(4)
  evalHeight  Int      @default(640)
  evalWidth   Int      @default(640)

  // Runtime settings
  useGpu      Boolean  @default(true)
  logIter     Int      @default(20)
  saveDir     String?
  snapshotEpoch Int    @default(1)

  // Output paths
  outputDir   String?
  weights     String?

  // Pretrained weights
  pretrainWeights String?

  yamlConfig  String?
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trainingJobs  TrainingJob[]
}

// Training Job
model TrainingJob {
  id          String   @id @default(cuid())
  projectId   String
  datasetId   String
  modelId     String
  configId    String?
  
  name        String
  status      String   @default("pending") // pending, running, completed, failed, stopped
  command     String?  // Generated training command
  
  // Eval and Infer commands
  evalCommand  String?  // Generated eval command
  inferCommand String?  // Generated infer command
  
  // Config file path
  configPath  String?  // Path to merged config YAML file
  
  // Error information
  errorMessage  String? // Error message if training failed
  
  // Progress
  currentEpoch  Int    @default(0)
  totalEpochs   Int    @default(100)
  currentLoss   Float?
  currentLr     Float?

  // PaddleSeg: best checkpoint tracking, populated from EVAL "best mIoU (X)
  // saved at iter N" line. Null for non-Seg frameworks.
  bestIter    Int?
  bestMetric  Float?  // Currently mIoU; kept generic for future eval keys
  
  // Paths
  outputDir     String?
  weightsPath   String?
  vdlLogDir     String?
  
  // Training parameters (JSON string)
  trainingParams String?
  
  // YAML configuration
  yamlConfig   String?
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Timing
  startedAt     DateTime?
  completedAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dataset       Dataset         @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  model         Model           @relation(fields: [modelId], references: [id], onDelete: Cascade)
  config        TrainingConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  
  logs        TrainingLog[]
  deployedModels DeployedModel[]
}

// Deployed Model Registry: promotes a trained checkpoint (optionally its
// TensorRT/inference export dir) into a first-class "production model" that
// can be quickly switched per `product` label. Multiple entries can exist for
// the same product; exactly one is expected to be isActive=true at a time
// (enforced at the application layer inside a transaction).
model DeployedModel {
  id            String   @id @default(cuid())
  name          String   // e.g. "line13-Aug-v3"
  product       String   // product label, primary switching key
  framework     String   // PaddleDetection / PaddleClas / PaddleSeg
  architecture  String?  // e.g. "PP-YOLOE", "PP-LiteSeg"; informational

  // Provenance (optional)
  projectId     String?
  trainingJobId String?

  // Runtime artifacts used by inference/eval
  configPath    String   // absolute path to merged YAML
  weightsPath   String   // absolute path to .pdparams (or model file)
  exportedDir   String?  // absolute path to export_model/<name> if exported

  // Metadata
  metrics       String?  // JSON: { mAP, mIoU, bestIter, ... }
  notes         String?
  isActive      Boolean  @default(false)

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  trainingJob   TrainingJob? @relation(fields: [trainingJobId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([product, framework])
  @@index([userId, product])
  @@unique([userId, product, name])
}

// Training Log
model TrainingLog {
  id          String   @id @default(cuid())
  jobId       String
  
  epoch       Int
  iteration   Int
  totalIter   Int
  
  loss        Float?
  lossCls     Float?
  lossIou     Float?
  lossDfl     Float?
  lossL1      Float?
  learningRate Float?

  // Segmentation metrics (nullable; populated for [EVAL] lines emitted by
  // PaddleSeg and TorchSeg)
  mIoU        Float?
  acc         Float?
  kappa       Float?
  dice        Float?

  // Detection metrics (nullable; parsed from the COCO summary block printed by
  // PaddleDetection and TorchDet). mAP is AP@[0.50:0.95], mAP50 is AP@0.50.
  mAP         Float?
  mAP50       Float?

  // Unsupervised anomaly-detection metrics (TorchAnomaly). AUROC/F1 are
  // reported separately at image level (is this part defective?) and pixel
  // level (where is the defect?); `threshold` is the anomaly score cut-off
  // anomalib's adaptive thresholding picked on the validation split.
  imageAuroc  Float?
  imageF1     Float?
  pixelAuroc  Float?
  pixelF1     Float?
  threshold   Float?

  eta         String?
  batchCost   Float?
  dataCost    Float?
  readerCost  Float?  // PaddleSeg reader_cost
  ips         Float?
  memReserved Int?    // MB
  memAllocated Int?   // MB
  
  // PaddleSeg per-class arrays for the eval that produced this row. JSON
  // string of shape {"iou":[..], "precision":[..], "recall":[..]}. Null
  // outside PaddleSeg EVAL rows. Kept as JSON to accommodate variable
  // num_classes without schema changes.
  classMetrics String?

  rawLog      String?  // Original log line
  
  timestamp   DateTime @default(now())
  
  job         TrainingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// Validation Job
model ValidationJob {
  id          String   @id @default(cuid())
  projectId   String
  trainingJobId String?  // Link to training job
  
  name        String
  
  type        String   @default("eval") // eval, infer
  
  // Config and weights
  configPath  String?  // Path to config YAML
  weightsPath String?  // Path to model weights
  
  // For eval
  datasetPath String?
  
  // For inference
  inferInputPath  String?  // Single image or folder path
  inferOutputPath String?  // Output folder for inference results
  
  status      String   @default("pending") // pending, running, completed, failed
  command     String?  // Generated command
  
  // Results
  resultJson  String?  // JSON string of metrics (mAP, etc.)
  resultPath  String?  // Path to results file/folder
  
  // Logs
  outputLog   String?  // Captured stdout/stderr
  
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  startedAt   DateTime?
  completedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// GPU Monitor Data (for history)
model GpuMetric {
  id          String   @id @default(cuid())
  gpuId       Int
  
  utilization Float   // GPU utilization percentage
  memoryUsed  Int     // MB used
  memoryTotal Int     // MB total
  temperature Int     // Celsius
  
  timestamp   DateTime @default(now())
}

// User Activity Log
model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action      String   // create_project, import_dataset, import_model, import_config, create_job, start_training, stop_training, etc.
  entityType  String   // project, dataset, model, config, job, etc.
  entityId    String?  // Related entity ID
  entityName  String?  // Related entity name for display
  details     String?  // JSON string for additional details
  
  createdAt   DateTime @default(now())
  
  @@index([userId, createdAt])
}
